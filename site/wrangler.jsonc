// foyelle.org on Cloudflare: static files built by scripts/deploy-site into out/site, with
// foyelle.org as the custom domain. The only code, worker.js, answers byte ranges for /media/*.
{
  "name": "foyelle-site",
  "compatibility_date": "2026-10-23",
  "main": "worker.js",
  "assets": {
    "directory": "../out/site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  "routes": [{ "pattern": "foyelle.org", "custom_domain": true }],
  "workers_dev": false
}
