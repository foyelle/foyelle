#!/usr/bin/env bash
# Run Nix from a container, for development machines without Nix installed
# (for example macOS). The store persists in the "foyelle-nix" volume.
#   scripts/nix-docker flake check
#   scripts/nix-docker build .#checks.aarch64-linux.policy
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
image="${FOYELLE_NIX_IMAGE:-nixos/nix:2.28.3}"
exec docker run --rm ${DOCKER_TTY:-} \
  -v foyelle-nix:/nix \
  -v "$root":/src -w /src \
  -e NIX_CONFIG=$'experimental-features = nix-command flakes\nmax-jobs = auto\naccept-flake-config = false\nsandbox = false' \
  "$image" nix "$@"
