#!/usr/bin/env python3
"""Forward a development VM's egress through the Mac's own network connection.

  scripts/host-proxy [--listen 192.168.64.1:3129] [--ports 443,993,465,587] [--wait]
  scripts/host-proxy install      run it in the background at login (a launchd agent)
  scripts/host-proxy uninstall    remove that agent

A VPN on the Mac that routes all traffic through its tunnel drops what UTM's shared network NATs
for the VM, so the VM cannot reach the internet, while programs on the Mac can. The dev VM's
egress proxies (foyelle.egressUpstream) forward their already-filtered requests here, and this
proxy opens them from the Mac, through the VPN.

It accepts only HTTP CONNECT, only to the listed ports, and only from UTM's shared network
(192.168.64.0/24); it listens on the bridge address, which exists while a VM runs. The host
allowlists stay in the VM. Development only: release images connect directly.
"""

from __future__ import annotations

import argparse
import asyncio
import errno
import ipaddress
import os
import plistlib
import shutil
import subprocess
import sys
from pathlib import Path

VM_NET = ipaddress.ip_network("192.168.64.0/24")
LABEL = "ai.foyelle.host-proxy"
AGENT = Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"
INSTALLED = Path.home() / "Library" / "Application Support" / "Foyelle" / "host-proxy"
LOG = Path.home() / "Library" / "Logs" / "foyelle-host-proxy.log"


async def pipe(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
    try:
        while data := await reader.read(65536):
            writer.write(data)
            await writer.drain()
    except (ConnectionError, OSError):
        pass
    finally:
        try:
            writer.close()
        except OSError:
            pass


async def handle(reader: asyncio.StreamReader, writer: asyncio.StreamWriter, ports: set[int]) -> None:
    peer = writer.get_extra_info("peername")[0]
    try:
        if ipaddress.ip_address(peer) not in VM_NET:
            return
        head = await asyncio.wait_for(reader.readuntil(b"\r\n\r\n"), 30)
        method, target, _ = head.split(b"\r\n", 1)[0].decode("latin-1").split(" ", 2)
        host, _, port_text = target.rpartition(":")
        port = int(port_text) if port_text.isdigit() else 0
        if method != "CONNECT" or not host or port not in ports:
            writer.write(b"HTTP/1.1 403 Forbidden\r\nContent-Length: 0\r\n\r\n")
            print(f"refused {method} {target} from {peer}", flush=True)
            return
        try:
            up_reader, up_writer = await asyncio.wait_for(asyncio.open_connection(host.strip("[]"), port), 30)
        except (OSError, asyncio.TimeoutError) as e:
            writer.write(b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n")
            print(f"failed {target}: {e}", flush=True)
            return
        print(f"CONNECT {target} from {peer}", flush=True)
        writer.write(b"HTTP/1.1 200 Connection established\r\n\r\n")
        await writer.drain()
        await asyncio.gather(pipe(reader, up_writer), pipe(up_reader, writer))
    except (asyncio.IncompleteReadError, asyncio.LimitOverrunError, asyncio.TimeoutError, ValueError, OSError):
        pass
    finally:
        try:
            writer.close()
        except OSError:
            pass


def launchctl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["launchctl", *args], capture_output=True, text=True, check=False)


def install() -> None:
    """Copy this script out of the checkout and run it at login, restarted if it stops."""
    INSTALLED.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(__file__, INSTALLED)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    AGENT.parent.mkdir(parents=True, exist_ok=True)
    AGENT.write_bytes(plistlib.dumps({
        "Label": LABEL,
        "ProgramArguments": [sys.executable, "-I", str(INSTALLED), "--wait"],
        "RunAtLoad": True,
        "KeepAlive": True,
        "StandardOutPath": str(LOG),
        "StandardErrorPath": str(LOG),
    }))
    domain = f"gui/{os.getuid()}"
    launchctl("bootout", f"{domain}/{LABEL}")
    result = launchctl("bootstrap", domain, str(AGENT))
    if result.returncode != 0:
        sys.exit(f"launchctl bootstrap failed: {result.stderr.strip()}")
    print(f"installed {AGENT} (log: {LOG})")


def uninstall() -> None:
    launchctl("bootout", f"gui/{os.getuid()}/{LABEL}")
    for path in (AGENT, INSTALLED):
        path.unlink(missing_ok=True)
    print("uninstalled")


async def main() -> None:
    if sys.argv[1:2] == ["install"]:
        return install()
    if sys.argv[1:2] == ["uninstall"]:
        return uninstall()
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--listen", default="192.168.64.1:3129")
    # HTTPS, plus IMAP (993) and SMTP (465, 587) for the mail connector. Which connector may reach
    # which host and port is still decided by the VM's own egress proxies.
    ap.add_argument("--ports", default="443,993,465,587", help="comma-separated CONNECT ports")
    ap.add_argument("--wait", action="store_true",
                    help="wait for the address to appear (it exists only while a UTM VM runs)")
    args = ap.parse_args()
    host, _, port = args.listen.rpartition(":")
    ports = {int(p) for p in args.ports.split(",")}
    waited = False
    while True:
        try:
            server = await asyncio.start_server(lambda r, w: handle(r, w, ports), host, int(port))
            break
        except OSError as e:
            if not args.wait or e.errno != errno.EADDRNOTAVAIL:
                sys.exit(f"cannot listen on {args.listen}: {e} (is a UTM VM with Shared Network running?)")
            if not waited:
                print(f"waiting for {host} (starts with the first UTM VM)", flush=True)
                waited = True
            await asyncio.sleep(5)
    print(f"forwarding CONNECT to ports {sorted(ports)} for {VM_NET} on {args.listen}", flush=True)
    async with server:
        await server.serve_forever()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        pass
