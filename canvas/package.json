{
  "name": "foyelle-canvas",
  "version": "0.1.0",
  "private": true,
  "description": "Foyelle canvas: the full-screen Electron shell that hosts chat and MCP App surfaces.",
  "license": "MIT",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:web": "node scripts/build.mjs --web && node dist-dev/dev-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@modelcontextprotocol/core": "2.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/ws": "8.18.1",
    "electron": "41.10.7",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
