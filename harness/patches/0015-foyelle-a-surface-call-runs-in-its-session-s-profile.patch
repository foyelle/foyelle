From: Mikael Rousson <85865+mmmikael@users.noreply.github.com>
Date: Tue, 27 Oct 2026 04:39:48 +0000
Subject: [PATCH 15/15] foyelle: a surface call runs in its session's profile

surface.call_tool bound the session but not its
profile, so a call the canvas made in a bot's conversation was decided
and routed as the launch profile's. They now run inside the session's
profile scope, after the MCP discovery a cron run does first (which
adopts the launch profile's connections), so the policy decides them as
that bot's.
---
 tests/tools/test_mcp_surfaces.py | 32 ++++++++++++++++++++++++++++++++
 tui_gateway/methods_surfaces.py  | 29 ++++++++++++++++++++++++++++-
 2 files changed, 60 insertions(+), 1 deletion(-)

diff --git a/tests/tools/test_mcp_surfaces.py b/tests/tools/test_mcp_surfaces.py
index 633f5bbb390f95891e27163c954838ec6e08a123..c71090fdbd8aa3f56600440620a1867285a52304 100644
--- a/tests/tools/test_mcp_surfaces.py
+++ b/tests/tools/test_mcp_surfaces.py
@@ -174,3 +174,35 @@ def test_tool_hints_are_kept_for_the_policy():
                              "mcp_svc_wipe")
     assert mcp_surfaces.tool_annotations("mcp_svc_wipe") == {"destructiveHint": True, "readOnlyHint": False}
     assert mcp_surfaces.tool_annotations("mcp_svc_unknown") == {}
+
+
+@pytest.mark.parametrize("profile_home", ["/homes/bot-travel", None])
+def test_a_surface_call_runs_in_its_sessions_profile(monkeypatch, profile_home):
+    import contextlib
+
+    import tools.mcp_tool_discovery as discovery
+    from tui_gateway import server
+
+    seen = []
+
+    @contextlib.contextmanager
+    def profile_scope(session, **_):
+        seen.append(("enter", session.get("profile_home")))
+        yield
+        seen.append(("exit", session.get("profile_home")))
+
+    monkeypatch.setattr(server, "_session_profile_runtime_scope", profile_scope)
+    monkeypatch.setattr(server, "_enable_gateway_prompts", lambda: None)
+    monkeypatch.setattr(discovery, "discover_mcp_tools", lambda *a, **k: seen.append(("discover", None)) or [])
+    monkeypatch.setattr(mcp_surfaces, "call_tool",
+                        lambda srv, tool, args, session_id="": seen.append(("call", tool)) or {"content": []})
+    monkeypatch.setitem(server._sessions, "s1", {"session_key": "k1", "profile_home": profile_home})
+
+    out = server._methods["surface.call_tool"]("r1", {"session_id": "s1", "server": "shell", "name": "bots_list",
+                                                     "arguments": {}})
+
+    assert "error" not in out
+    if profile_home:
+        assert seen == [("enter", profile_home), ("discover", None), ("call", "bots_list"), ("exit", profile_home)]
+    else:
+        assert seen == [("call", "bots_list")]
diff --git a/tui_gateway/methods_surfaces.py b/tui_gateway/methods_surfaces.py
index 3b8a6c67ce832115cf9e9e9e6285a24ed700b771..07869acd26efc61a3dbb658beeafd32771657255 100644
--- a/tui_gateway/methods_surfaces.py
+++ b/tui_gateway/methods_surfaces.py
@@ -13,6 +13,32 @@ def _surface_session(params):
     return sid, (_sessions.get(sid) if sid else None)
 
 
+def _surface_profile_scope(session):
+    """Foyelle: a surface's call runs in its session's profile (each of the person's bots is one), so the
+    policy decides it as that bot's and it reaches that profile's MCP connections, discovered (adopted
+    from the launch profile's) the way a cron run does first. The launch profile's sessions: as before."""
+    import contextlib
+
+    @contextlib.contextmanager
+    def scope():
+        if session is None or not session.get("profile_home"):
+            yield
+            return
+        with _session_profile_runtime_scope(session):
+            try:
+                from tools.mcp_tool_discovery import discover_mcp_tools
+
+                discover_mcp_tools()
+            except Exception as exc:  # the call itself reports a server that is not there
+                import logging
+
+                logging.getLogger(__name__).warning("surface call: MCP discovery for %s failed: %s",
+                                                    session.get("profile_home"), exc)
+            yield
+
+    return scope()
+
+
 @method("surface.list")
 def _surface_list(rid, params):
     from tools import mcp_surfaces
@@ -71,7 +97,8 @@ def _surface_call_tool(rid, params):
     session_tokens = _set_session_context(session["session_key"], ui_session_id=sid) if session is not None else []
     try:
         _enable_gateway_prompts()
-        return _ok(rid, mcp_surfaces.call_tool(server, name, arguments, session_id=sid))
+        with _surface_profile_scope(session):
+            return _ok(rid, mcp_surfaces.call_tool(server, name, arguments, session_id=sid))
     except LookupError as exc:
         return _err(rid, 4004, str(exc))
     except Exception as exc:
