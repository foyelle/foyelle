 hermes_cli/plugins_discovery.py               | 16 +++
 hermes_cli/plugins_loader.py                  |  7 +-
 hermes_cli/web_server_app.py                  |  3 +
 .../test_foyelle_required_plugins.py          | 98 +++++++++++++++++++
 5 files changed, 159 insertions(+), 3 deletions(-)
 create mode 100644 tests/hermes_cli/test_foyelle_required_plugins.py

