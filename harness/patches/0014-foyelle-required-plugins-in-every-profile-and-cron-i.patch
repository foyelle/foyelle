diff --git a/tests/hermes_cli/test_foyelle_required_plugins.py b/tests/hermes_cli/test_foyelle_required_plugins.py
new file mode 100644
index 0000000000000000000000000000000000000000..42fcd4bb1e1236fb21da13b842309176da862d37
--- /dev/null
+++ b/tests/hermes_cli/test_foyelle_required_plugins.py
@@ -0,0 +1,98 @@
+"""Foyelle: required plugins (HERMES_REQUIRED_PLUGINS_DIR) load in every profile and fail closed."""
+
+from pathlib import Path
+
+import hermes_yaml as yaml
+import pytest
+
+import hermes_cli.plugins as plugins_mod
+from hermes_cli.plugins import get_pre_tool_call_block_message, missing_required_plugins
+
+GATE = """
+def _gate(tool_name, args, **kwargs):
+    if tool_name == "forbidden":
+        return {"action": "block", "message": "blocked by the policy"}
+    return None
+
+
+def register(ctx):
+    ctx.register_hook("pre_tool_call", _gate)
+"""
+
+
+def _plugin(base: Path, name: str, body: str) -> Path:
+    directory = base / name
+    directory.mkdir(parents=True, exist_ok=True)
+    (directory / "plugin.yaml").write_text(
+        yaml.safe_dump({"name": name, "version": "0.1.0", "description": name}), encoding="utf-8")
+    (directory / "__init__.py").write_text(body, encoding="utf-8")
+    return directory
+
+
+@pytest.fixture
+def required(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    required_dir = tmp_path / "required"
+    required_dir.mkdir()
+    monkeypatch.setenv("HERMES_REQUIRED_PLUGINS_DIR", str(required_dir))
+    monkeypatch.setattr(plugins_mod, "_required_plugin_names", None)
+    return home, required_dir
+
+
+def test_a_required_plugin_loads_without_being_enabled(required):
+    home, required_dir = required
+    _plugin(required_dir, "policy", GATE)
+
+    assert missing_required_plugins() == []
+    assert get_pre_tool_call_block_message("forbidden", {}) == "blocked by the policy"
+    assert get_pre_tool_call_block_message("todo", {}) is None
+
+
+def test_config_cannot_disable_a_required_plugin(required):
+    home, required_dir = required
+    _plugin(required_dir, "policy", GATE)
+    (home / "config.yaml").write_text(yaml.safe_dump({"plugins": {"disabled": ["policy"]}}), encoding="utf-8")
+
+    assert missing_required_plugins() == []
+    assert get_pre_tool_call_block_message("forbidden", {}) == "blocked by the policy"
+
+
+def test_a_profile_copy_does_not_shadow_the_required_plugin(required):
+    home, required_dir = required
+    _plugin(required_dir, "policy", GATE)
+    _plugin(home / "plugins", "policy", "def register(ctx):\n    pass\n")
+    (home / "config.yaml").write_text(yaml.safe_dump({"plugins": {"enabled": ["policy"]}}), encoding="utf-8")
+
+    assert get_pre_tool_call_block_message("forbidden", {}) == "blocked by the policy"
+
+
+def test_every_tool_is_blocked_when_a_required_plugin_fails_to_load(required):
+    home, required_dir = required
+    _plugin(required_dir, "policy", "def register(ctx):\n    raise RuntimeError('broken')\n")
+
+    assert missing_required_plugins() == ["policy"]
+    message = get_pre_tool_call_block_message("todo", {})
+    assert message and "required plugin policy is not loaded" in message
+
+
+def test_a_required_plugin_without_a_tool_hook_counts_as_missing(required):
+    home, required_dir = required
+    _plugin(required_dir, "policy", "def register(ctx):\n    pass\n")
+
+    assert missing_required_plugins() == ["policy"]
+    assert get_pre_tool_call_block_message("todo", {})
+
+
+def test_an_empty_required_directory_blocks_everything(required):
+    assert missing_required_plugins()
+    assert get_pre_tool_call_block_message("todo", {})
+
+
+def test_no_required_directory_changes_nothing(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_REQUIRED_PLUGINS_DIR", raising=False)
+
+    assert missing_required_plugins() == []
+    assert get_pre_tool_call_block_message("todo", {}) is None
