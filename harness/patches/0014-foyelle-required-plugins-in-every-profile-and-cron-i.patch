--- a/hermes_cli/plugins.py
+++ b/hermes_cli/plugins.py
@@ -1904,6 +1904,40 @@ def clear_thread_tool_whitelist() -> None:
     _thread_tool_whitelist.allowed = None
 
 
+_required_plugin_names: Optional[frozenset[str]] = None
+
+
+def missing_required_plugins() -> list[str]:
+    """Foyelle: the required plugins (``HERMES_REQUIRED_PLUGINS_DIR``) that are not loaded, enabled and
+    hooked into ``pre_tool_call`` in the current profile's manager. Fails closed: an unreadable required
+    directory or a manager that can't load counts every required plugin as missing."""
+    global _required_plugin_names
+    from hermes_cli.plugins_discovery import required_plugins_dir, scan_directory
+    directory = required_plugins_dir()
+    if directory is None:
+        return []
+    if _required_plugin_names is None:
+        try:
+            _required_plugin_names = frozenset(m.name for m in scan_directory(directory, "required"))
+        except Exception:
+            logger.exception("Required plugins directory %s is unreadable", directory)
+            return [str(directory)]
+        if not _required_plugin_names:
+            logger.error("Required plugins directory %s holds no plugin", directory)
+    if not _required_plugin_names:
+        return [str(directory)]
+    try:
+        manager = get_plugin_manager()
+        manager.discover_and_load()
+        loaded = {p.manifest.name for p in list(manager._plugins.values())
+                  if p.enabled and not p.error and p.manifest.source == "required"
+                  and "pre_tool_call" in p.hooks_registered}
+    except Exception:
+        logger.exception("Checking the required plugins failed")
+        return sorted(_required_plugin_names)
+    return sorted(_required_plugin_names - loaded)
+
+
