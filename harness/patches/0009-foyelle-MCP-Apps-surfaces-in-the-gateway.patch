index 0000000000000000000000000000000000000000..54a9607a7d21ffd7458af307079c5a42eec9e387
--- /dev/null
+++ b/tools/mcp_surfaces.py
@@ -0,0 +1,251 @@
+"""Foyelle: MCP Apps (SEP-1865) surfaces for gateway clients.
+
+A connector tool that declares ``_meta.ui.resourceUri`` (or the legacy ``_meta["ui/resourceUri"]``)
+has a visual surface: an HTML resource (``text/html;profile=mcp-app``) that a client renders in a
+sandboxed frame. This module records which registered tools have one, reads those resources over
+the live MCP session, lists the ``ui://`` resources servers expose, and lets a surface call tools of
+its own server through the same dispatch path (plugin hooks, policy, approvals) as a model call.
+"""
+
+from __future__ import annotations
+
+import contextvars
+import json
+import logging
+import threading
+import uuid
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+UI_MIME_TYPE = "text/html;profile=mcp-app"
+_LEGACY_META_KEY = "ui/resourceUri"
+_READ_TIMEOUT = 30.0
+_MAX_HTML_BYTES = 2 * 1024 * 1024
+
+_lock = threading.Lock()
+# registry tool name -> (server name, MCP tool name)
+_tools: dict[str, tuple[str, str]] = {}
+# (server name, MCP tool name) -> registry tool name
+_registry_names: dict[tuple[str, str], str] = {}
+# registry tool name -> ui:// resource URI
+_ui_uris: dict[str, str] = {}
+
+# "model" for calls the agent makes, "surface" while a surface's own tool call is dispatched.
+_origin: contextvars.ContextVar[str] = contextvars.ContextVar("foyelle_tool_call_origin", default="model")
+
+
+def current_origin() -> str:
+    """Who started the tool call being dispatched: ``model`` or ``surface``."""
+    return _origin.get()
+
+
+def _meta_of(tool: Any) -> dict:
+    if isinstance(tool, dict):
+        meta = tool.get("_meta") or tool.get("meta")
+    else:
+        meta = getattr(tool, "meta", None)
+        if meta is None:
+            meta = getattr(tool, "_meta", None)
+    return meta if isinstance(meta, dict) else {}
+
+
+def tool_ui_uri(tool: Any) -> Optional[str]:
+    """The ``ui://`` resource a tool declares, in either the nested or the legacy flat format."""
+    meta = _meta_of(tool)
+    ui = meta.get("ui")
+    uri = ui.get("resourceUri") if isinstance(ui, dict) else None
+    uri = uri or meta.get(_LEGACY_META_KEY)
+    return uri if isinstance(uri, str) and uri.startswith("ui://") else None
+
+
+def record_tool(server_name: str, tool: Any, registry_name: str) -> None:
+    """Called at registration for every MCP tool (initial discovery and list_changed refresh)."""
+    tool_name = tool.get("name") if isinstance(tool, dict) else getattr(tool, "name", None)
+    if not tool_name or not registry_name:
+        return
+    uri = tool_ui_uri(tool)
+    with _lock:
+        _tools[registry_name] = (server_name, tool_name)
+        _registry_names[(server_name, tool_name)] = registry_name
+        if uri:
+            _ui_uris[registry_name] = uri
+        else:
+            _ui_uris.pop(registry_name, None)
+
+
+def ui_tool(registry_name: str) -> Optional[tuple[str, str, str]]:
+    """``(server, tool, uri)`` when the registered tool has a surface."""
+    with _lock:
+        uri = _ui_uris.get(registry_name)
+        pair = _tools.get(registry_name)
+    return (pair[0], pair[1], uri) if uri and pair else None
+
+
+def registry_name_for(server_name: str, tool_name: str) -> Optional[str]:
+    with _lock:
+        return _registry_names.get((server_name, tool_name))
+
+
+def server_of(registry_name: str) -> Optional[str]:
+    with _lock:
+        pair = _tools.get(registry_name)
+    return pair[0] if pair else None
+
+
+def _connected_session(server_name: str):
+    from tools.mcp_tool_discovery import _get_connected_server_for_call
+
+    server = _get_connected_server_for_call(server_name)
+    session = getattr(server, "session", None) if server is not None else None
+    if session is None:
+        raise LookupError(f"MCP server {server_name!r} is not connected")
+    return session
+
+
+def _dump(model: Any) -> Any:
+    if hasattr(model, "model_dump"):
+        return model.model_dump(mode="json", by_alias=True, exclude_none=True)
+    return model
+
+
+def read_resource(server_name: str, uri: str) -> dict:
+    """``resources/read`` on the live session; returns the MCP ``ReadResourceResult`` as JSON."""
+    from tools.mcp_tool_loop import _run_on_mcp_loop
+
+    session = _connected_session(server_name)
+
+    async def _read():
+        try:
+            return await session.read_resource(uri)  # current SDKs take the URI as a string
+        except Exception as exc:  # older SDKs validate it as AnyUrl
+            if "valid url" not in str(exc).lower() and "anyurl" not in str(exc).lower():
+                raise
+            from pydantic import AnyUrl
+
+            return await session.read_resource(AnyUrl(uri))
+
+    return _dump(_run_on_mcp_loop(_read, timeout=_READ_TIMEOUT))
+
+
+def surface_document(server_name: str, uri: str) -> dict:
+    """The renderable part of a ``ui://`` resource: ``{html, csp?, permissions?}``."""
+    contents = read_resource(server_name, uri).get("contents") or []
+    for item in contents:
+        if not isinstance(item, dict) or not isinstance(item.get("text"), str):
+            continue
+        mime = str(item.get("mimeType") or "")
+        if mime.split(";")[0].strip() != "text/html":
+            continue
+        html = item["text"]
+        if len(html.encode("utf-8")) > _MAX_HTML_BYTES:
+            raise ValueError(f"surface {uri} is larger than {_MAX_HTML_BYTES} bytes")
+        doc: dict[str, Any] = {"html": html}
+        ui_meta = (item.get("_meta") or {}).get("ui") if isinstance(item.get("_meta"), dict) else None
+        if isinstance(ui_meta, dict):
+            if isinstance(ui_meta.get("csp"), dict):
+                doc["csp"] = ui_meta["csp"]
+            if isinstance(ui_meta.get("permissions"), dict):
+                doc["permissions"] = ui_meta["permissions"]
+        return doc
+    raise LookupError(f"{uri} on {server_name!r} has no text/html content")
+
+
+def list_surfaces() -> list[dict]:
+    """Every ``ui://`` resource the connected servers list (system surfaces, pinned views)."""
+    from tools import mcp_tool as _core
+    from tools.mcp_tool_loop import _run_on_mcp_loop
+
+    with _core._lock:
+        servers = [(getattr(s, "name", None) or str(k[-1] if isinstance(k, tuple) else k), s)
+                   for k, s in _core._servers.items()]
+    out: list[dict] = []
+    for name, server in servers:
+        session = getattr(server, "session", None)
+        if session is None:
+            continue
+        try:
+            listed = _dump(_run_on_mcp_loop(lambda s=session: s.list_resources(), timeout=_READ_TIMEOUT))
+        except Exception as exc:  # a server without resources/list support, or a dead one
+            logger.debug("surfaces: list_resources on %r failed: %s", name, exc)
+            continue
+        for res in listed.get("resources") or []:
+            uri = str(res.get("uri") or "")
+            if not uri.startswith("ui://"):
+                continue
+            meta = res.get("_meta") if isinstance(res.get("_meta"), dict) else {}
+            out.append({
+                "server": name, "uri": uri, "name": str(res.get("name") or uri),
+                "title": str(res.get("title") or res.get("name") or uri),
+                "pinned": bool((meta.get("foyelle") or {}).get("pinned")) if isinstance(meta.get("foyelle"), dict) else False,
+            })
+    return out
+
+
+def tool_result_for_app(result: Any) -> dict:
+    """Hermes's rendered MCP tool result (JSON string or dict) -> an MCP ``CallToolResult`` shape."""
+    if isinstance(result, str):
+        try:
+            result = json.loads(result)
+        except (TypeError, ValueError):
+            return {"content": [{"type": "text", "text": result}]}
+    if not isinstance(result, dict):
+        return {"content": [{"type": "text", "text": json.dumps(result, ensure_ascii=False, default=str)}]}
+    if "error" in result and "result" not in result:
+        return {"content": [{"type": "text", "text": str(result["error"])}], "isError": True}
+    body = result.get("result")
+    out: dict[str, Any] = {"content": []}
+    if isinstance(body, str):
+        if body:
+            out["content"].append({"type": "text", "text": body})
+    elif body is not None:
+        out["structuredContent"] = body
+        out["content"].append({"type": "text", "text": json.dumps(body, ensure_ascii=False, default=str)})
+    if isinstance(result.get("structuredContent"), (dict, list)):
+        out["structuredContent"] = result["structuredContent"]
+    return out
+
+
+def surface_event_for_tool(session_id: str, tool_call_id: str, registry_name: str, args: Any,
+                           result: Any) -> Optional[dict]:
+    """The ``surface.open`` payload for a finished tool call, or None when the tool has no surface."""
+    found = ui_tool(registry_name)
+    if found is None:
+        return None
+    server, tool, uri = found
+    try:
+        doc = surface_document(server, uri)
+    except Exception as exc:
+        logger.warning("surfaces: cannot read %s from %r: %s", uri, server, exc)
+        return None
+    return {
+        "surface_id": f"s-{uuid.uuid4().hex[:16]}", "session_id": session_id, "server": server, "tool": tool,
+        "tool_call_id": tool_call_id, "uri": uri, **doc,
+        "tool_input": args if isinstance(args, dict) else {}, "tool_result": tool_result_for_app(result),
+    }
+
+
+def resource_payload(server_name: str, uri: str, session_id: str = "") -> dict:
+    """The ``surface.open_resource`` result: a surface opened without a tool call."""
+    if not uri.startswith("ui://"):
+        raise ValueError("surface URIs must use the ui:// scheme")
+    return {"surface_id": f"s-{uuid.uuid4().hex[:16]}", "session_id": session_id, "server": server_name,
+            "uri": uri, **surface_document(server_name, uri)}
+
+
+def call_tool(server_name: str, tool_name: str, arguments: dict, *, session_id: str = "") -> dict:
+    """A surface calling a tool of its own server. Dispatched through ``handle_function_call`` so
+    ``pre_tool_call``/``post_tool_call`` plugins (Foyelle's policy engine and audit log) and the
+    approval gate see it exactly like a model call; returns a ``CallToolResult`` shape."""
+    registry_name = registry_name_for(server_name, tool_name)
+    if registry_name is None:
+        raise LookupError(f"{server_name!r} has no registered tool {tool_name!r}")
+    from model_tools import handle_function_call
+
+    token = _origin.set("surface")
+    try:
+        raw = handle_function_call(registry_name, dict(arguments or {}), task_id=session_id or None,
+                                   tool_call_id=f"surface-{uuid.uuid4().hex[:12]}", session_id=session_id or None)
+    finally:
+        _origin.reset(token)
+    return tool_result_for_app(raw)
