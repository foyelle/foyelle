new file mode 100644
index 0000000000000000000000000000000000000000..bed2fbbf070e42d06247efbe7f6d7ac079b4aa3d
--- /dev/null
+++ b/tests/tools/test_mcp_surfaces.py
@@ -0,0 +1,133 @@
+"""Foyelle: MCP Apps surfaces (tools/mcp_surfaces.py) and their gateway wiring."""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tools import mcp_surfaces
+
+
+@pytest.fixture(autouse=True)
+def _clean_registry():
+    for table in (mcp_surfaces._tools, mcp_surfaces._registry_names, mcp_surfaces._ui_uris):
+        table.clear()
+    yield
+    for table in (mcp_surfaces._tools, mcp_surfaces._registry_names, mcp_surfaces._ui_uris):
+        table.clear()
+
+
+def _tool(name, meta=None):
+    return SimpleNamespace(name=name, meta=meta)
+
+
+def test_tool_ui_uri_reads_nested_and_legacy_formats():
+    assert mcp_surfaces.tool_ui_uri(_tool("a", {"ui": {"resourceUri": "ui://files/browser"}})) == "ui://files/browser"
+    assert mcp_surfaces.tool_ui_uri(_tool("b", {"ui/resourceUri": "ui://mail/inbox"})) == "ui://mail/inbox"
+    assert mcp_surfaces.tool_ui_uri({"name": "c", "_meta": {"ui": {"resourceUri": "ui://x/y"}}}) == "ui://x/y"
+
+
+def test_tool_ui_uri_rejects_other_schemes_and_missing_meta():
+    assert mcp_surfaces.tool_ui_uri(_tool("a", {"ui": {"resourceUri": "https://evil.example/app"}})) is None
+    assert mcp_surfaces.tool_ui_uri(_tool("b")) is None
+    assert mcp_surfaces.tool_ui_uri(_tool("c", {"ui": "ui://not-a-dict"})) is None
+
+
+def test_record_tool_maps_registry_names_both_ways():
+    mcp_surfaces.record_tool("files", _tool("browse", {"ui": {"resourceUri": "ui://files/browser"}}), "mcp_files_browse")
+    mcp_surfaces.record_tool("files", _tool("read"), "mcp_files_read")
+    assert mcp_surfaces.ui_tool("mcp_files_browse") == ("files", "browse", "ui://files/browser")
+    assert mcp_surfaces.ui_tool("mcp_files_read") is None
+    assert mcp_surfaces.registry_name_for("files", "read") == "mcp_files_read"
+    assert mcp_surfaces.server_of("mcp_files_browse") == "files"
+
+
+def test_record_tool_drops_a_surface_removed_on_refresh():
+    mcp_surfaces.record_tool("files", _tool("browse", {"ui": {"resourceUri": "ui://files/browser"}}), "mcp_files_browse")
+    mcp_surfaces.record_tool("files", _tool("browse"), "mcp_files_browse")
+    assert mcp_surfaces.ui_tool("mcp_files_browse") is None
+
+
+@pytest.mark.parametrize(("raw", "expected"), [
+    (json.dumps({"result": "hello"}), {"content": [{"type": "text", "text": "hello"}]}),
+    (json.dumps({"result": "", "structuredContent": {"n": 1}}), {"content": [], "structuredContent": {"n": 1}}),
+    (json.dumps({"result": {"n": 2}}), {"content": [{"type": "text", "text": "{\"n\": 2}"}], "structuredContent": {"n": 2}}),
+    (json.dumps({"error": "boom"}), {"content": [{"type": "text", "text": "boom"}], "isError": True}),
+    ("not json", {"content": [{"type": "text", "text": "not json"}]}),
+])
+def test_tool_result_for_app(raw, expected):
+    assert mcp_surfaces.tool_result_for_app(raw) == expected
+
+
+def test_surface_event_for_tool_builds_the_open_payload(monkeypatch):
+    mcp_surfaces.record_tool("files", _tool("browse", {"ui": {"resourceUri": "ui://files/browser"}}), "mcp_files_browse")
+    monkeypatch.setattr(mcp_surfaces, "surface_document",
+                        lambda server, uri: {"html": "<!doctype html><p>hi</p>", "csp": {"connectDomains": []}})
+    event = mcp_surfaces.surface_event_for_tool("sess-1", "call-1", "mcp_files_browse", {"path": "/"},
+                                                json.dumps({"result": "ok"}))
+    assert event["surface_id"].startswith("s-")
+    assert {k: event[k] for k in ("session_id", "server", "tool", "tool_call_id", "uri", "html")} == {
+        "session_id": "sess-1", "server": "files", "tool": "browse", "tool_call_id": "call-1",
+        "uri": "ui://files/browser", "html": "<!doctype html><p>hi</p>"}
+    assert event["tool_input"] == {"path": "/"}
+    assert event["tool_result"] == {"content": [{"type": "text", "text": "ok"}]}
+    assert mcp_surfaces.surface_event_for_tool("sess-1", "call-2", "mcp_files_read", {}, "{}") is None
+
+
+def test_surface_event_is_skipped_when_the_resource_cannot_be_read(monkeypatch):
+    mcp_surfaces.record_tool("files", _tool("browse", {"ui": {"resourceUri": "ui://files/browser"}}), "mcp_files_browse")
+
+    def _fail(server, uri):
+        raise LookupError("not connected")
+
+    monkeypatch.setattr(mcp_surfaces, "surface_document", _fail)
+    assert mcp_surfaces.surface_event_for_tool("s", "c", "mcp_files_browse", {}, "{}") is None
+
+
+def test_surface_document_picks_html_and_ui_meta(monkeypatch):
+    monkeypatch.setattr(mcp_surfaces, "read_resource", lambda server, uri: {"contents": [
+        {"uri": uri, "mimeType": "application/json", "text": "{}"},
+        {"uri": uri, "mimeType": "text/html;profile=mcp-app", "text": "<p>x</p>",
+         "_meta": {"ui": {"csp": {"connectDomains": ["https://api.example"]}, "permissions": {"camera": {}}}}},
+    ]})
+    doc = mcp_surfaces.surface_document("web", "ui://web/results")
+    assert doc == {"html": "<p>x</p>", "csp": {"connectDomains": ["https://api.example"]}, "permissions": {"camera": {}}}
+
+
+def test_resource_payload_refuses_non_ui_uris():
+    with pytest.raises(ValueError):
+        mcp_surfaces.resource_payload("files", "file:///etc/passwd")
+
+
+def test_call_tool_dispatches_through_handle_function_call_as_a_surface(monkeypatch):
+    import model_tools
+
+    seen = {}
+
+    def _fake(name, args, **kw):
+        seen.update(name=name, args=args, origin=mcp_surfaces.current_origin(), **kw)
+        return json.dumps({"result": "done"})
+
+    monkeypatch.setattr(model_tools, "handle_function_call", _fake)
+    mcp_surfaces.record_tool("files", _tool("trash"), "mcp_files_trash")
+    out = mcp_surfaces.call_tool("files", "trash", {"path": "a.txt"}, session_id="sess-9")
+    assert out == {"content": [{"type": "text", "text": "done"}]}
+    assert seen["name"] == "mcp_files_trash" and seen["args"] == {"path": "a.txt"}
+    assert seen["origin"] == "surface" and seen["session_id"] == "sess-9"
+    assert mcp_surfaces.current_origin() == "model"
+
+
+def test_call_tool_rejects_tools_the_server_did_not_register():
+    with pytest.raises(LookupError):
+        mcp_surfaces.call_tool("files", "rm_rf", {})
+
+
+def test_gateway_registers_surface_methods_on_the_long_pool():
+    from tui_gateway import server
+    from tui_gateway.contracts import EVENTS, METHODS
+
+    for name in ("surface.list", "surface.open_resource", "surface.read_resource", "surface.call_tool"):
+        assert name in server._methods
+        assert name in METHODS
+        assert name in server._LONG_HANDLERS
+    assert "surface.open" in EVENTS
