+++ b/tui_gateway/methods_surfaces.py
@@ -0,0 +1,87 @@
+"""Foyelle: MCP Apps surface RPCs (``surface.*``). See ``tools/mcp_surfaces.py``."""
+
+from .method_ctx import HandlerRegistry, bind_module
+
+_registry = HandlerRegistry()
+method = _registry.method
+_SURFACE_LONG_METHODS = frozenset({"surface.call_tool", "surface.read_resource", "surface.open_resource",
+                                   "surface.list"})
+
+
+def _surface_session(params):
+    sid = params.get("session_id") or ""
+    return sid, (_sessions.get(sid) if sid else None)
+
+
+@method("surface.list")
+def _surface_list(rid, params):
+    from tools import mcp_surfaces
+
+    try:
+        return _ok(rid, {"surfaces": mcp_surfaces.list_surfaces()})
+    except Exception as exc:
+        return _err(rid, 5000, f"surface.list failed: {exc}")
+
+
+@method("surface.open_resource")
+def _surface_open_resource(rid, params):
+    from tools import mcp_surfaces
+
+    server, uri = params.get("server") or "", params.get("uri") or ""
+    if not server or not uri:
+        return _err(rid, 4000, "server and uri are required")
+    try:
+        return _ok(rid, mcp_surfaces.resource_payload(server, uri, params.get("session_id") or ""))
+    except (LookupError, ValueError) as exc:
+        return _err(rid, 4004, str(exc))
+    except Exception as exc:
+        return _err(rid, 5000, f"surface.open_resource failed: {exc}")
+
+
+@method("surface.read_resource")
+def _surface_read_resource(rid, params):
+    from tools import mcp_surfaces
+
+    server, uri = params.get("server") or "", params.get("uri") or ""
+    if not server or not uri:
+        return _err(rid, 4000, "server and uri are required")
+    try:
+        result = mcp_surfaces.read_resource(server, uri)
+        return _ok(rid, {"contents": result.get("contents") or []})
+    except LookupError as exc:
+        return _err(rid, 4004, str(exc))
+    except Exception as exc:
+        return _err(rid, 5000, f"surface.read_resource failed: {exc}")
+
+
+@method("surface.call_tool")
+def _surface_call_tool(rid, params):
+    """A surface's own tool call, bound to its session so approvals reach this client."""
+    from tools import mcp_surfaces
+    from tools.approval_context import reset_current_session_key, set_current_session_key
+
+    server, name = params.get("server") or "", params.get("name") or ""
+    arguments = params.get("arguments") or {}
+    if not server or not name or not isinstance(arguments, dict):
+        return _err(rid, 4000, "server, name and an arguments object are required")
+    sid, session = _surface_session(params)
+    if sid and session is None:
+        return _err(rid, 4004, f"unknown session {sid!r}")
+    approval_token = set_current_session_key(session["session_key"]) if session is not None else None
+    session_tokens = _set_session_context(session["session_key"], ui_session_id=sid) if session is not None else []
+    try:
+        _enable_gateway_prompts()
+        return _ok(rid, mcp_surfaces.call_tool(server, name, arguments, session_id=sid))
+    except LookupError as exc:
+        return _err(rid, 4004, str(exc))
+    except Exception as exc:
+        return _err(rid, 5000, f"surface.call_tool failed: {exc}")
+    finally:
+        if approval_token is not None:
+            reset_current_session_key(approval_token)
+        _clear_session_context(session_tokens)
+
+
+def register(server):
+    bind_module(globals(), server, skip=("_",))
+    server._LONG_HANDLERS = server._LONG_HANDLERS | _SURFACE_LONG_METHODS
