@@ -0,0 +1,103 @@
+"""Foyelle: contracts for MCP Apps surfaces (``surface.*`` methods and the ``surface.open`` event)."""
+
+from __future__ import annotations
+
+from .base import JsonValue, Params, Payload, Result
+from .registry import event, method
+
+
+class SurfaceCsp(Payload):
+    """``_meta.ui.csp`` of the resource: extra origins the surface may reach (empty by default)."""
+
+    model_config = Payload.model_config | {"extra": "allow"}
+
+    connectDomains: list[str] | None = None  # noqa: N815 - MCP Apps wire names
+    resourceDomains: list[str] | None = None  # noqa: N815
+
+
+class SurfaceDocument(Result):
+    surface_id: str
+    session_id: str = ""
+    server: str
+    uri: str
+    html: str
+    csp: SurfaceCsp | None = None
+    permissions: JsonValue = None
+
+
+class SurfaceOpenPayload(Payload):
+    """``tools.mcp_surfaces.surface_event_for_tool``: a tool with a ``ui://`` surface finished."""
+
+    surface_id: str
+    session_id: str
+    server: str
+    tool: str
+    tool_call_id: str
+    uri: str
+    html: str
+    csp: SurfaceCsp | None = None
+    permissions: JsonValue = None
+    tool_input: JsonValue = None
+    tool_result: JsonValue = None
+
+
+event("surface.open", SurfaceOpenPayload,
+      doc="A tool with an MCP Apps surface finished: render html in a sandboxed frame and send it the input and result.")
+
+
+class SurfaceListParams(Params):
+    pass
+
+
+class SurfaceEntry(Result):
+    server: str
+    uri: str
+    name: str
+    title: str
+    pinned: bool = False
+
+
+class SurfaceListResult(Result):
+    surfaces: list[SurfaceEntry]
+
+
+method("surface.list", params=SurfaceListParams, result=SurfaceListResult,
+       doc="Every ui:// resource the connected MCP servers expose.")
+
+
+class SurfaceResourceParams(Params):
+    server: str
+    uri: str
+    session_id: str | None = None
+
+
+method("surface.open_resource", params=SurfaceResourceParams, result=SurfaceDocument,
+       doc="Open a surface without a tool call (system surfaces such as status, memory, settings, audit).")
+
+
+class SurfaceReadResult(Result):
+    contents: list[JsonValue]
+
+
+method("surface.read_resource", params=SurfaceResourceParams, result=SurfaceReadResult,
+       doc="resources/read on behalf of a surface.")
+
+
+class SurfaceCallToolParams(Params):
+    server: str
+    name: str
+    arguments: dict[str, JsonValue] | None = None
+    session_id: str | None = None
+    surface_id: str | None = None
+
+
+class SurfaceCallToolResult(Result):
+    model_config = Result.model_config | {"extra": "allow"}
+
+    content: list[JsonValue]
+    structuredContent: JsonValue = None  # noqa: N815 - MCP wire name
+    isError: bool | None = None  # noqa: N815
+
+
+method("surface.call_tool", params=SurfaceCallToolParams, result=SurfaceCallToolResult,
+       doc="A surface calls a tool of its own server; the call goes through the policy and approval path.")
