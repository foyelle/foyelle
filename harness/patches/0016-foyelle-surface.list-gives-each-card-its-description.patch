diff --git a/tests/tools/test_mcp_surfaces.py b/tests/tools/test_mcp_surfaces.py
index c71090fdbd8aa3f56600440620a1867285a52304..92205b53426955fcdb4703576af35dd88216c0da 100644
--- a/tests/tools/test_mcp_surfaces.py
+++ b/tests/tools/test_mcp_surfaces.py
@@ -111,6 +111,26 @@ def test_resource_payload_runs_the_surface_tool_that_needs_no_arguments(monkeypa
     assert "tool_result" not in mcp_surfaces.resource_payload("mon", "ui://mon/detail.html", "s1")
 
 
+def test_list_surfaces_gives_each_card_its_description_and_service(monkeypatch):
+    from tools import mcp_tool, mcp_tool_loop
+
+    listed = {"resources": [
+        {"uri": "ui://files/browser", "name": "browser", "title": "Files", "description": "Browse your files."},
+        {"uri": "ui://kiwi/flights", "name": "flights", "title": "Flights", "description": "Flights found.",
+         "_meta": {"foyelle": {"service": "Kiwi.com", "pinned": True}}},
+        {"uri": "file:///notes.txt", "name": "notes"},
+    ]}
+    session = SimpleNamespace(list_resources=lambda: listed)
+    monkeypatch.setattr(mcp_tool, "_servers", {"files": SimpleNamespace(name="files", session=session)})
+    monkeypatch.setattr(mcp_tool_loop, "_run_on_mcp_loop", lambda fn, timeout=None: fn())
+    assert mcp_surfaces.list_surfaces() == [
+        {"server": "files", "uri": "ui://files/browser", "name": "browser", "title": "Files",
+         "description": "Browse your files.", "service": None, "pinned": False},
+        {"server": "files", "uri": "ui://kiwi/flights", "name": "flights", "title": "Flights",
+         "description": "Flights found.", "service": "Kiwi.com", "pinned": True},
+    ]
+
+
 def test_resource_payload_refuses_non_ui_uris():
     with pytest.raises(ValueError):
         mcp_surfaces.resource_payload("files", "file:///etc/passwd")
diff --git a/tools/mcp_surfaces.py b/tools/mcp_surfaces.py
index b1fe19525b63437c9999d70d101aadaf5daff411..dc52b1d54a0b383109cdfaf485d29d7426170391 100644
--- a/tools/mcp_surfaces.py
+++ b/tools/mcp_surfaces.py
@@ -202,10 +202,16 @@ def list_surfaces() -> list[dict]:
             if not uri.startswith("ui://"):
                 continue
             meta = res.get("_meta") if isinstance(res.get("_meta"), dict) else {}
+            foyelle = meta.get("foyelle") if isinstance(meta.get("foyelle"), dict) else {}
+            service = foyelle.get("service")
             out.append({
                 "server": name, "uri": uri, "name": str(res.get("name") or uri),
                 "title": str(res.get("title") or res.get("name") or uri),
-                "pinned": bool((meta.get("foyelle") or {}).get("pinned")) if isinstance(meta.get("foyelle"), dict) else False,
+                # What the card shows, in the helper's words (the resource's description), and the
+                # online service it belongs to when the helper is a bridge to one.
+                "description": str(res.get("description") or ""),
+                "service": str(service) if isinstance(service, str) and service else None,
+                "pinned": bool(foyelle.get("pinned")),
             })
     return out
 
